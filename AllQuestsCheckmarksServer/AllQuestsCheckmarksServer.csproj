<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SPTPath Condition="'$(SPTPath)' == ''">C:\sptarkov\SPTarkov 5.0.0-BE-1.3.0.0.48484</SPTPath>
    <RootNamespace>AllQuestsCheckmarks</RootNamespace>
    <Title>All Quests Checkmarks</Title>
    <Authors>ZGFueDkx</Authors>
    <AssemblyName>AllQuestsCheckmarks-Server</AssemblyName>
    <AssemblyVersion>1.4.0</AssemblyVersion>
    <Version>$(AssemblyVersion)</Version>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Copyright>Copyright © 2026 $(Authors)</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SPTarkov.Common;SPTarkov.DI;SPTarkov.Server.Core;SemanticVersioning"><HintPath>$(SPTPath)/SPT_Runtime/%(Identity).dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="StagePlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);../LICENSE;../README.md" DestinationFolder="../Build/SPT_Runtime/user/mods/AllQuestsCheckmarks" />
  </Target>
</Project>
