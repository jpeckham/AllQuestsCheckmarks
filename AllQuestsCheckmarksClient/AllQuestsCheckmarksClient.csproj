<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <SPTPath Condition="'$(SPTPath)' == ''">C:\sptarkov\SPTarkov 5.0.0-BE-1.3.0.0.48484</SPTPath>
    <RootNamespace>AllQuestsCheckmarks</RootNamespace>
    <Title>All Quests Checkmarks</Title>
    <Authors>ZGFueDkx</Authors>
    <AssemblyName>AllQuestsCheckmarks-Client</AssemblyName>
    <AssemblyVersion>1.4.0</AssemblyVersion>
    <Version>$(AssemblyVersion)</Version>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Copyright>Copyright © 2026 $(Authors)</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Patches/ItemSpecificationPanelPatch.cs" />
    <Compile Include="../Shared/**/*.cs" Exclude="../Shared/obj/**;../Shared/bin/**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core;BepInEx.Unity.IL2CPP;Il2CppInterop.Runtime;Il2CppInterop.Common;0Harmony"><HintPath>$(SPTPath)/BepInEx/core/%(Identity).dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(SPTPath)/BepInEx/interop/*.dll" Exclude="$(SPTPath)/BepInEx/interop/Newtonsoft.Json.dll"><Private>false</Private></Reference>
    <Reference Include="SPTushonka.Reflection;SPTushonka.Common"><HintPath>$(SPTPath)/BepInEx/plugins/sptushonka/%(Identity).dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <Target Name="StagePlugin" AfterTargets="Build">
    <ItemGroup><LocaleFiles Include="locales/*.json" /></ItemGroup>
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Newtonsoft.Json.dll;../LICENSE;../README.md;../THIRD-PARTY-NOTICES.md" DestinationFolder="../Build/BepInEx/plugins/AllQuestsCheckmarks" />
    <Copy SourceFiles="Assets/Bundle" DestinationFiles="../Build/BepInEx/plugins/AllQuestsCheckmarks/AllQuestsCheckmarksAssets" />
    <Copy SourceFiles="@(LocaleFiles)" DestinationFolder="../Build/BepInEx/plugins/AllQuestsCheckmarks/locales" />
  </Target>
</Project>
